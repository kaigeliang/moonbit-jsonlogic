supported_targets = "native"

import {
  "kaigeliang/jsonlogic" @logic,
  "kaigeliang/jsonlogic/queryx" @adapter,
  "jaredzhou/queryx" @qx,
  "jaredzhou/foxql",
  "jaredzhou/foxql/ast",
  "jaredzhou/foxql/builder",
